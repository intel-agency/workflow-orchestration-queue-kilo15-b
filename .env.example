# GitHub authentication (required)
GITHUB_TOKEN=your_github_token_here

# Target repository in "owner/repo" format (required)
GITHUB_REPO=owner/repo

# Bot account GitHub login (required)
SENTINEL_BOT_LOGIN=your-bot-login

# HMAC secret for webhook validation (optional)
WEBHOOK_SECRET=

# Heartbeat interval in seconds (optional, default: 300)
SENTINEL_HEARTBEAT_INTERVAL=300
